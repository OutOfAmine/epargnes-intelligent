rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /feedback/{docId} {
      allow create: if true;
      allow read: if false;
    }
    match /errors/{docId} {
      allow create: if true;
      allow read: if false;
    }
    match /stats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
